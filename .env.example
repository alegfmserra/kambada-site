# =============================================================================
# Kambada — variáveis de ambiente
# Copie para .env.local e preencha. .env.local NUNCA vai para o repositório.
# =============================================================================

# --- Site ---------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="https://somoskambada.com.br"

# --- Bling (Fase 2) -----------------------------------------------------
# Gerados em: Bling > Preferências > Integrações > API > criar aplicativo.
# Só server-side. Nunca prefixar com NEXT_PUBLIC_.
BLING_CLIENT_ID=""
BLING_CLIENT_SECRET=""
# Deve bater exatamente com a URL cadastrada no aplicativo do Bling.
BLING_REDIRECT_URI="https://somoskambada.com.br/api/bling/callback"
# Segredo compartilhado para validar o webhook de estoque/produto do Bling.
BLING_WEBHOOK_SECRET=""

# --- Mercado Pago (Fase 3) ----------------------------------------------
MERCADOPAGO_ACCESS_TOKEN=""
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=""
MERCADOPAGO_WEBHOOK_SECRET=""

# --- Revalidação de cache -----------------------------------------------
# Protege a rota que invalida o cache do catálogo. Gere um valor aleatório longo.
REVALIDATE_SECRET=""
